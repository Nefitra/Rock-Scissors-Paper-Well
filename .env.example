# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=https://play.cyberduel.app

# TELEGRAM_BOT_TOKEN: The bot API token for @CyberDuellitebot
TELEGRAM_BOT_TOKEN=""

# VIRAL_COMMUNITY_CHAT_ID: The production community chat ID (e.g. -100xxxxxxxxxx)
VIRAL_COMMUNITY_CHAT_ID=""

# Custodial TON gaming balance configuration (options: mainnet, testnet)
TON_NETWORK=mainnet
TON_TREASURY_ADDRESS=EQB3nYo1HZv66-F9RNL96vO7eNnQn18wP-98jT8N7q2q2q2q
TON_HOT_WALLET_ADDRESS=EQCD39VS5JC97yw9pYFXb19uLJ7Yg7y3nYo1HZv66-F9RNL96
TON_HOT_WALLET_MNEMONIC=""

# Risk and emergency control configurations
EMERGENCY_PAUSE_TON_DEPOSITS=true
EMERGENCY_PAUSE_TON_GAMES=true
EMERGENCY_PAUSE_TON_WITHDRAWALS=true


# Migration defaults: no writes, bot changes or financial workers until reviewed.
FINANCIAL_ACTIONS_ENABLED=false
TELEGRAM_BOT_ENABLED=false
TON_DEPOSIT_MONITOR_ENABLED=false
TON_WITHDRAWAL_WORKER_ENABLED=false
# Optional Admin SDK credentials mounted outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json

# Fresh installation: generate a strong PG_PASSWORD locally on the server.
DATABASE_PROVIDER=postgres
PG_PASSWORD=
DATABASE_URL=postgres://cyberduel:REPLACE_WITH_PG_PASSWORD@postgres:5432/cyberduel
APP_WRITES_ENABLED=false
# A random webhook secret; do not commit the deployed value.
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram IDs only, never usernames. Empty means no administrator.
ADMIN_TELEGRAM_IDS=
